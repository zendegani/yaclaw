# Pishkar configuration. Copy to `.env` and fill in whichever you use —
# `.env` is gitignored. Loaded automatically by `python -m pishkar.server`.


# --- LLM provider keys ---
# When multiple keys are set and PISHKAR_MODEL is unset, the first key
# present in this order wins:
#   ANTHROPIC > OPENAI > OPENROUTER > GROQ > MOONSHOT > DASHSCOPE > GEMINI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Either GEMINI_API_KEY or GOOGLE_API_KEY works for Gemini.
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# Kimi (Moonshot AI). Models like `moonshot-v1-8k`, `moonshot-v1-32k`.
# MOONSHOT_API_KEY=
# Qwen via Alibaba DashScope. Models like `qwen-turbo`, `qwen-plus`, `qwen-max`.
# DASHSCOPE_API_KEY=

# Optional explicit model override (litellm naming).
# PISHKAR_MODEL=anthropic/claude-opus-4-7
# PISHKAR_MODEL=openrouter/qwen/qwen-2.5-72b-instruct
# PISHKAR_MODEL=groq/llama-3.3-70b-versatile
# PISHKAR_MODEL=moonshot/moonshot-v1-8k
# PISHKAR_MODEL=dashscope/qwen-turbo


# --- Tool result cap ---
# Maximum bytes a single tool result can return before it is truncated
# with a "[truncated: …]" notice. The result still goes back to the LLM
# as the model's next-turn input, so this is effectively the per-tool
# context budget. Default 16000 fits comfortably under free-tier TPM
# limits (e.g. Groq Scout at 30k tokens/min). Raise on paid tiers.
# PISHKAR_TOOL_MAX_BYTES=16000


# --- Web search & reading ---
# Pishkar's `search` tool walks engines in fallback order on API errors.
# `auto` (default) uses PISHKAR_SEARCH_ENGINE if set, else picks based on
# which key below is present, falling back to keyless DuckDuckGo last.
# Override per call by passing `engine="brave"` etc. to the tool.
# PISHKAR_SEARCH_ENGINE=tavily

# Tavily — purpose-built search API for AI agents (https://tavily.com).
# TAVILY_API_KEY=
# Brave Search API (https://api.search.brave.com).
# BRAVE_API_KEY=
# Jina Reader — clean-markdown rendering for the `read_url` tool. Works
# keyless with strict rate limits; set the key for higher quotas.
# JINA_API_KEY=


# --- Telegram channel (optional) ---
# Both must be set to enable the Telegram bot. Get the token from
# @BotFather (`/newbot`) and your numeric user ID from @userinfobot.
# Only messages from TELEGRAM_OWNER_ID are processed; everyone else is
# silently ignored. /new in chat starts a fresh session.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=


# --- LLM-trace backend (optional) ---
# Selects the self-hosted observability UI. Default is `phoenix` (single
# container, ~300 MB resident — fits a Pi 5 8 GB alongside the butler).
# Use `langfuse` on a VPS for richer prompt-management / cost dashboards,
# or `none` to disable LLM tracing (the always-on SQLite audit log keeps
# running either way).
# PISHKAR_TRACE_BACKEND=phoenix

# Arize Phoenix (when PISHKAR_TRACE_BACKEND=phoenix)
# Run with: docker run -d -p 6006:6006 -v phoenix-data:/mnt/data \
#           -e PHOENIX_WORKING_DIR=/mnt/data arizephoenix/phoenix:latest
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT=pishkar

# LangFuse (when PISHKAR_TRACE_BACKEND=langfuse)
# Pin the image to v2 (Postgres-only) to avoid the v3 ClickHouse RAM
# footprint: `image: langfuse/langfuse:2` in your docker-compose.
# Both keys are required; get them from the LangFuse UI on first boot.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000


# --- HuggingFace (currently unused) ---
# Not read by any code path today; reserved for future local-model
# integration via `transformers` / `huggingface_hub`.
# HF_TOKEN=hf_
